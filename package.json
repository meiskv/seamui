{
  "name": "seamui-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/www dev",
    "build": "bun run --cwd apps/www build",
    "registry:build": "bun run --cwd apps/www registry:build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --cwd apps/www typecheck && bun run --cwd packages/seamui typecheck",
    "motion:check": "bun run scripts/motion-contract.ts",
    "test": "bun run --cwd apps/www test",
    "test:watch": "bun run --cwd apps/www test:watch",
    "test:coverage": "bun run --cwd apps/www test:coverage",
    "test:e2e": "bun run --cwd apps/www test:e2e",
    "drift:check": "bun run scripts/check-drift.ts",
    "smoke": "bun run scripts/release-smoke.ts",
    "verify": "bun run lint && bun run typecheck && bun run motion:check && bun run test && bun run drift:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3"
  }
}
