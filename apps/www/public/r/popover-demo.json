{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-demo",
  "type": "registry:example",
  "title": "Popover Demo",
  "registryDependencies": [
    "https://seamui.vercel.app/r/popover.json",
    "https://seamui.vercel.app/r/button.json"
  ],
  "files": [
    {
      "path": "registry/seam/examples/popover-demo.tsx",
      "content": "import { Button } from \"@/registry/seam/ui/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@/registry/seam/ui/popover\"\n\nexport default function PopoverDemo() {\n  return (\n    <Popover>\n      <PopoverTrigger render={<Button variant=\"outline\">Open</Button>} />\n      <PopoverContent>\n        <div className=\"space-y-1\">\n          <h4 className=\"text-sm font-medium\">Dimensions</h4>\n          <p className=\"text-muted-foreground text-sm\">\n            Set the surface size. The panel rises toward you on open.\n          </p>\n        </div>\n      </PopoverContent>\n    </Popover>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}