{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tooltip-shortcut",
  "type": "registry:example",
  "title": "Tooltip Shortcut",
  "registryDependencies": [
    "https://seamui.dev/r/tooltip.json",
    "https://seamui.dev/r/button.json",
    "https://seamui.dev/r/kbd.json"
  ],
  "files": [
    {
      "path": "registry/seam/examples/tooltip-shortcut.tsx",
      "content": "import { Button } from \"@/registry/seam/ui/button\"\nimport { Kbd } from \"@/registry/seam/ui/kbd\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/registry/seam/ui/tooltip\"\n\nexport default function TooltipShortcut() {\n  return (\n    <TooltipProvider>\n      <Tooltip>\n        <TooltipTrigger render={<Button variant=\"outline\">Save</Button>} />\n        <TooltipContent>\n          <span className=\"flex items-center gap-2\">\n            Save <Kbd>⌘S</Kbd>\n          </span>\n        </TooltipContent>\n      </Tooltip>\n    </TooltipProvider>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}