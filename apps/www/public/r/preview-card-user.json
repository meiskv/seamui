      "content": "import { Avatar, AvatarFallback } from \"@/registry/seam/ui/avatar\"\nimport {\n  PreviewCard,\n  PreviewCardContent,\n  PreviewCardTrigger,\n} from \"@/registry/seam/ui/preview-card\"\n\nexport default function PreviewCardUser() {\n  return (\n    <p className=\"text-sm\">\n      Design notes from{\" \"}\n      <PreviewCard>\n        <PreviewCardTrigger\n          render={<a href=\"https://base-ui.com\" className=\"underline\" />}\n        >\n          @seamui\n        </PreviewCardTrigger>\n        <PreviewCardContent>\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-3\">\n              <Avatar className=\"size-11\">\n                <AvatarFallback>SU</AvatarFallback>\n              </Avatar>\n              <div className=\"space-y-0.5\">\n                <div className=\"font-medium leading-none\">seamui</div>\n                <div className=\"text-muted-foreground text-sm leading-none\">\n                  @seamui\n                </div>\n              </div>\n            </div>\n            <p className=\"text-sm\">\n              Tactile, spring-driven UI components you own — built on Base UI\n              and motion.dev.\n            </p>\n            <div className=\"text-muted-foreground text-sm\">\n              128 Following · 2.4k Followers\n            </div>\n          </div>\n        </PreviewCardContent>\n      </PreviewCard>\n      .\n    </p>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
