{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-align",
  "type": "registry:example",
  "title": "Popover Align",
  "registryDependencies": [
    "https://seamui.dev/r/popover.json",
    "https://seamui.dev/r/button.json"
  ],
  "files": [
    {
      "path": "registry/seam/examples/popover-align.tsx",
      "content": "import { Button } from \"@/registry/seam/ui/button\"\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@/registry/seam/ui/popover\"\n\nexport default function PopoverAlign() {\n  return (\n    <div className=\"flex gap-3\">\n      <Popover>\n        <PopoverTrigger\n          render={<Button variant=\"outline\">Align start</Button>}\n        />\n        <PopoverContent align=\"start\">\n          <p className=\"text-sm\">Aligned to the start edge of the trigger.</p>\n        </PopoverContent>\n      </Popover>\n      <Popover>\n        <PopoverTrigger render={<Button variant=\"outline\">Align end</Button>} />\n        <PopoverContent align=\"end\">\n          <p className=\"text-sm\">Aligned to the end edge of the trigger.</p>\n        </PopoverContent>\n      </Popover>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ]
}